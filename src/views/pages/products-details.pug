extends ../layouts/home

include ../../blocks/modules/product-detail/product-detail.pug
include ../../blocks/modules/objects/objects.pug
include ../../blocks/modules/reviews/reviews.pug
include ../../blocks/modules/faq/faq.pug
include ../../blocks/modules/about-us/about-us.pug
include ../../blocks/modules/product-tabs/product-tabs.pug

include ../../blocks/components/breadcrumb/breadcrumb.pug


block variables
  include ../../data/data.pug
  - const title = "Продукция - Ecoboard"

block content
    section.section-page
        .container
            .page
                .page__breadcrumbs
                    +breadcrumb([
                        'Главная',
                        'Продукция',
                        'Фибросайдинг ЭкоБоард Классик',
                    ])


    +product-detail(app.productData)
    +product-content-sections(app.productTabsData)
    +about(app.aboutHeroDetails)
    +objects
    +reviews
    +faq(app.faqData)

block scripts
  script(src="/js/common.js")
