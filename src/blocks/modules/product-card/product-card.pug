mixin product-card(data)
  .product-card-item
    .container
      .product-card
        .product-card__inner
          // Left Column: Content
          .product-card__content
            span.product-card__label= data.label
            h2.product-card__title= data.title


            .product-card__desc
              | Классический фиброцементный сайдинг для горизонтальной обшивки внахлёст ёлочкой.
              | В том числе данный профиль может применяться для обустройства углов дома,
              | наличников, откосов в проёмах, лобовой доски крыши и пр.
            .product-card__row
              .product-card__features
                h3.product-card__subtitle Особенности:
                ul.product-card__list
                  each item in data.list
                    li= item

              if !data.disableColor
                .product-card__colors
                  h3.product-card__subtitle Популярные цвета:
                  .product-card__color-grid

                    each color in app.colors
                      .product-card__color-item
                        .product-card__swatch(style=`background-color: ${color.hex}`)
                        span.product-card__color-name= color.code
                  .product-card__colors-note Больше цветов по запросу

            .product-card__price-block
              .product-card__price= data.price

              .product-card__actions
                a.btn.btn(href=data.details)= data.button
                button.btn.btn-white(href="#" data-popup='ajax' data-src="popup_order") Оставить заявку

          // Right Column: Image
          .product-card__media
            if(data.imagesArray)
              ul.product-card__grid
                each item in data.imagesArray
                  li: a(href="/products-components.html#c"+item.id): +bgimage(item.image)
            else
              .product-card__imagebg
                +bgimage(data.img)
