mixin feature-card(item)
  .feature-card
    .feature-card__content
      h3.feature-card__title= item.title
      p.feature-card__text= item.text
    .feature-card__icon
      //- Вставляем SVG иконку, переданную в данных (если она есть), либо заглушку
      if item.icon === 'hexagon'
          +bgimage('/img/icons/01.svg')
      else if item.icon === 'puzzle'
          +bgimage('/img/icons/02.svg')
      else if item.icon === 'like'
          +bgimage('/img/icons/03.svg')

mixin about(data)
  section.section-.about-hero
    .container
      .about-hero
        .about-hero__bg
            img(src=data.bgImage, alt="Производство")
        .about-hero__inner
          //- Левая колонка: Контент и фоновое изображение
          .about-hero__content-col
            //- Фоновое изображение (на мобилке и десктопе)


            .about-hero__content-wrapper
              .about-hero__label
                span.about-hero__label-line
                =data.text

              h2.about-hero__title!= data.title
              p.about-hero__desc= data.description
              a.about-hero__btn(href=data.buttonLink): button.btn.btn-white= data.buttonText

              //- Блок видео
            .about-hero__video
              .about-hero__video-info
                h3.about-hero__video-title= data.video.title
                p.about-hero__video-subtitle= data.video.subtitle
              a(href="/static/2b43054b3fee264029060016f5acbc0487802ede.mp4" data-fslightbox=""): button.about-hero__video-btn(type="button" aria-label="Смотреть видео")
                svg(width="25", height="28", fill="none", xmlns="http://www.w3.org/2000/svg")
                  path(d="M23.262 11.771c1.35.767 1.35 2.713 0 3.479L2.987 26.758C1.654 27.514 0 26.55 0 25.018V2.003C0 .47 1.654-.493 2.987.263l20.275 11.508z", fill="#E01B25")

          //- Правая колонка: Преимущества
          .about-hero__features-col
            .about-hero__features-bg
            .about-hero__features-list
              each item in data.features
                +feature-card(item)
