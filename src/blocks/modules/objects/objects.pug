mixin objects
  .objects
    .container
      .objects__header
        h2.objects__title Объекты с нашей продукцией
        a.objects__all-btn(href="#"): button.btn.btn-gray Смотреть все объекты

      .objects__grid
        each obj, index in app.objects
          .objects__card
            .objects__card__img
              img(src=obj.img alt=obj.title loading="lazy")
            .objects__card__content
              h3.objects__card__title= obj.title
              p.objects__card__text= obj.desc


      .objects__mobile-btn
        button.btn.btn-gray(type="button") Смотреть все объекты
