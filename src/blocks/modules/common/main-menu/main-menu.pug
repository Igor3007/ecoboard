mixin mobile-menu(menuData)
  .mobile-menu
    //- Шапка меню
    .mobile-menu__header
      span.mobile-menu__title Меню
      button.mobile-menu__close(type="button" aria-label="Закрыть меню")
        +icons('#ic_close', 20)

    //- Навигация
    .mobile-menu__content
      nav.mobile-menu__nav
        ul.mobile-menu__list
          each item in menuData
            if item.sub
              //- Если есть подменю, используем details/summary для аккордеона
              li.mobile-menu__item.mobile-menu__item--has-sub
                details.mobile-menu__details
                  summary.mobile-menu__summary
                    span= item.text
                    span.mobile-menu__arrow
                      +icons('#ic_arrow-down', 12) //- Или другой класс для стрелки
                  ul.mobile-menu__sub-list
                    each sub in item.sub
                      li.mobile-menu__sub-item
                        a(href=sub.href)= sub.text
            else
              //- Обычный пункт меню
              li.mobile-menu__item
                a.mobile-menu__link(href=item.href)= item.text

    //- Нижняя часть: Контакты и кнопки
    .mobile-menu__footer
      a.mobile-menu__phone(href="tel:+79227013050") +7 (922) 701-30-50

      button.mobile-menu__callback(type="button" data-popup="ajax" data-src="popup_callback")
        +icons('#ic_callback', 18)
        span Заказать звонок

      //- Соцсети (можно вынести в отдельный миксин, если нужно)
      .mobile-menu__social
        ul
          li: a(href="#"): +icons('#ic_tg')
          li: a(href="#"): +icons('#ic_ph')
          li: a(href="#"): +icons('#ic_vk')
