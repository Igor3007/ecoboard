extends ../layouts/home

include ../../blocks/modules/product-card/product-card.pug
include ../../blocks/modules/objects/objects.pug
include ../../blocks/modules/reviews/reviews.pug
include ../../blocks/modules/faq/faq.pug
include ../../blocks/components/breadcrumb/breadcrumb.pug


block variables
  include ../../data/data.pug
  - const title = "Продукция - Ecoboard"

block content
    section.section-page
        .container
            .page
                .page__breadcrumbs
                    +breadcrumb([
                        'Главная',
                        'Продукция',
                        'Фибросайдинг ЭкоБоард Классик',
                    ])


    section.section-product-cart
        +product-card({
            label: 'Фиброцементный сайдинг',
            title: 'ЭкоБоард Классик',
            list: [
                'Размер: 200*3000*8 мм',
                'Монтаж: внахлёст ёлочкой',
                'Фактура: дерево',
                'Материал: фиброцемент (целлюлоза)',
                'Площадь общая: 0,6 м²',
                'Площадь полезная (при монтаже ёлочкой): 0,51 м²',
            ],
            button: 'Подробнее про Классик',
            img: '/img/product/img-frame.png',
            price: 'от 6 400 ₽ / м²'
        })


    br
