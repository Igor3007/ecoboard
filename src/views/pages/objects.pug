extends ../layouts/home

include ../../blocks/components/breadcrumb/breadcrumb.pug

include ../../blocks/modules/objects/objects.pug
include ../../blocks/modules/reviews/reviews.pug
include ../../blocks/modules/faq/faq.pug



block variables
  include ../../data/data.pug
  - const title = "Все объекты"

block content
  section.section-page
    .container
      .page
        .page__breadcrumbs
          +breadcrumb([
            'Главная',
            'Объекты с нашим фибросайдингом',
          ])
        .page__h1: h1 Объекты с нашим фибросайдингом

  section.section-page-objects
    .container
      .page-objects
        .page-objects__list
          each item in app.objects
            .page-objects__item: +object-card(item)




  +reviews(app.reviewsData)
  +faq(app.faqData)


block scripts
  script(src="/js/common.js")
